<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Colebourn Consulting provides specialist power systems and operational technology solutions for industrial and critical infrastructure environments." />
  <meta name="theme-color" content="#0b1220" />
  <title>Colebourn Consulting | Power Systems & OT</title>
  <style>
    :root {
      --bg: #09131d;
      --bg-2: #0d1a27;
      --panel: rgba(14, 22, 32, 0.86);
      --panel-strong: rgba(18, 28, 39, 0.96);
      --line: rgba(121, 142, 167, 0.2);
      --text: #edf4ff;
      --muted: #a7b8ce;
      --muted-2: #7990b0;
      --accent: #f5b301;
      --accent-2: #ffcf52;
      --accent-soft: rgba(245, 179, 1, 0.12);
      --success: #8dd6b2;
      --shadow: rgba(0, 0, 0, 0.35);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      min-height: 100%;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background:
        radial-gradient(circle at top right, rgba(245,179,1,0.10), transparent 22%),
        linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 40px 40px,
        linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 40px 40px,
        linear-gradient(180deg, var(--bg-2), var(--bg));
      color: var(--text);
      scroll-behavior: smooth;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    main {
      width: min(100%, 1100px);
      background: rgba(8, 16, 25, 0.7);
      border: 1px solid var(--line);
      border-radius: 24px;
      padding: clamp(1.5rem, 3vw, 3rem);
      box-shadow: 0 30px 80px var(--shadow);
      backdrop-filter: blur(4px);
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      min-width: 0;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--accent-soft);
      border: 1px solid rgba(245, 179, 1, 0.3);
    }

    .brand-mark svg {
      width: 18px;
      height: 18px;
      stroke: var(--accent);
    }

    .brand-text {
      font-weight: 700;
      letter-spacing: 0.04em;
      font-size: 0.95rem;
      text-transform: uppercase;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.85rem;
      border-radius: 999px;
      border: 1px solid rgba(245,179,1,0.35);
      background: rgba(245,179,1,0.04);
      color: var(--accent-2);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .badge::before {
      content: "";
      width: 8px;
      height: 8px;
      background: var(--success);
      border-radius: 50%;
      box-shadow: 0 0 12px rgba(141, 214, 178, 0.8);
    }

    .hero {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 2rem;
      align-items: center;
      padding: 1rem 0 1.5rem;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 1rem;
      padding: 0.5rem 0.8rem;
      border-left: 2px solid var(--accent);
      background: rgba(245, 179, 1, 0.04);
      color: var(--accent-2);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(2.8rem, 5vw, 5rem);
      line-height: 0.95;
      letter-spacing: -0.06em;
      margin-bottom: 1rem;
      font-weight: 800;
    }

    h1 .highlight {
      color: var(--accent);
    }

    .subtitle {
      max-width: 620px;
      font-size: 1.08rem;
      line-height: 1.7;
      color: var(--muted);
      margin-bottom: 1.5rem;
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin-bottom: 2rem;
    }

    .button {
      display: inline-block;
      padding: 0.92rem 1.4rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 700;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      border: 1px solid transparent;
    }

    .button.primary {
      background: linear-gradient(180deg, var(--accent-2), var(--accent));
      color: #111827;
      box-shadow: 0 10px 24px rgba(245,179,1,0.25);
    }

    .button.secondary {
      background: rgba(255,255,255,0.01);
      color: var(--text);
      border-color: rgba(245,179,1,0.3);
    }

    .button:hover,
    .button:focus-visible {
      transform: translateY(-1px);
      text-decoration: none;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(120px, 1fr));
      gap: 0.8rem;
      max-width: 520px;
    }

    .stat {
      padding: 1rem 0.95rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: rgba(8, 18, 27, 0.9);
    }

    .stat strong {
      display: block;
      font-size: 1.5rem;
      color: var(--accent-2);
      margin-bottom: 0.25rem;
      letter-spacing: -0.04em;
    }

    .stat span {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-2);
    }

    .panel {
      background: linear-gradient(180deg, rgba(14,22,32,0.9), rgba(11,16,24,0.96));
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 1.25rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.74rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 14px rgba(141,214,178,0.8);
      display: inline-block;
      margin-right: 0.5rem;
    }

    .system-box {
      display: grid;
      gap: 0.8rem;
    }

    .system-item {
      padding: 0.9rem 0.8rem;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: rgba(255,255,255,0.01);
    }

    .system-item .label {
      display: block;
      margin-bottom: 0.3rem;
      color: var(--muted-2);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .system-item .value {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text);
    }

    .services {
      margin-top: 2rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .service-card {
      background: rgba(10, 16, 24, 0.8);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 1.3rem;
    }

    .service-card h3 {
      font-size: 1.1rem;
      margin: 0.8rem 0 0.55rem;
      letter-spacing: -0.03em;
    }

    .service-card p {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.95rem;
    }

    .icon-box {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: rgba(245,179,1,0.08);
      border: 1px solid rgba(245,179,1,0.2);
      color: var(--accent-2);
    }

    .icon-box svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
    }

    footer {
      margin-top: 2.25rem;
      padding-top: 1.2rem;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 0.92rem;
    }

    a {
      color: var(--accent-2);
      text-decoration: none;
    }

    a:hover,
    a:focus-visible {
      text-decoration: underline;
    }

    @media (max-width: 820px) {
      .hero {
        grid-template-columns: 1fr;
      }

      .services {
        grid-template-columns: 1fr;
      }

      .topbar {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 520px) {
      body { padding: 1rem; }
      .stats {
        grid-template-columns: 1fr;
      }
      .cta-row {
        flex-direction: column;
      }
      .button {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <main>
    <div class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>
